/* ============================================================
   qllama 主题 · dark（深色）
   控件外观全部集中在本文件；聊天 HTML / 头像 / 图标着色见 src/Theme.cpp
   ============================================================ */

QWidget {
    font-size: 13px;
    color: #e4e4ee;
}

/* —— 窗口与容器：深色渐变底，半透明亮色卡片叠于其上 —— */
QMainWindow, QDialog {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #25263a, stop: 1 #14151f);
}

#centralwidget {
    background: transparent;
}

/* —— 玻璃卡片（模型工具条 / 聊天区 / 输入框） —— */
QFrame#modelBar {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
}

/* 系统监控信息（状态栏右侧常驻） */
#monitorLabel {
    color: #a6a6bc;
    font-size: 12px;
    padding-right: 8px;
}

/* 配置页提示文字 */
#basicHint {
    color: #7c7c94;
    font-size: 12px;
}

/* 模型状态指示灯：state = idle / loading / ok / error */
QLabel#statusDot {
    font-size: 13px;
    color: #7c7c94;
}

QLabel#statusDot[state="loading"] {
    color: #f5a623;
}

QLabel#statusDot[state="ok"] {
    color: #2ecc71;
}

QLabel#statusDot[state="error"] {
    color: #e5484d;
}

QTextBrowser {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    padding: 12px;
    font-size: 15px;
    selection-background-color: #6f8cff;
}

QTextEdit {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
    padding: 8px 10px;
    font-size: 14px;
    selection-background-color: #6f8cff;
}

QTextEdit:focus {
    border: 1px solid #8fa8ff;
    background: rgba(255, 255, 255, 0.12);
}

/* —— 图片附件缩略图 —— */
QPushButton[objectName="thumbBtn"] {
    border: 2px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    padding: 0;
}

QPushButton[objectName="thumbBtn"]:hover {
    border: 2px solid #ff6b6b;
    background: rgba(255, 255, 255, 0.14);
}

/* —— 单行输入与数字框 —— */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 5px 10px;
    selection-background-color: #6f8cff;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #8fa8ff;
    background: rgba(255, 255, 255, 0.12);
}

/* —— 数字框上下箭头：加宽按钮区、放大箭头（替换 macOS 原生小箭头） —— */
QSpinBox, QDoubleSpinBox {
    min-height: 26px;
    padding-right: 30px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    height: 12px;
    margin: 1px 3px 0 0;
    border: none;
    border-top-right-radius: 7px;
    background: rgba(255, 255, 255, 0.08);
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    height: 12px;
    margin: 0 3px 1px 0;
    border: none;
    border-bottom-right-radius: 7px;
    background: rgba(255, 255, 255, 0.08);
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(143, 168, 255, 0.25);
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: rgba(143, 168, 255, 0.40);
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 11px;
    height: 11px;
    image: url(:/assets/icons/chevron-up-dark.svg);
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 11px;
    height: 11px;
    image: url(:/assets/icons/chevron-down-dark.svg);
}

/* —— 按钮 —— */
QPushButton {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9px;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.08);
    color: #e4e4ee;
    font-weight: 500;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.15);
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.05);
}

QPushButton:disabled {
    background: rgba(255, 255, 255, 0.04);
    color: rgba(228, 228, 238, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.07);
}

/* 主操作按钮：靛蓝 → 紫罗兰渐变 */
#loadBtn, #sendBtn {
    border: none;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #6f8cff, stop: 1 #a06bff);
    color: white;
    font-weight: 600;
}

#loadBtn:hover, #sendBtn:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #85a0ff, stop: 1 #b07fff);
}

#loadBtn:pressed, #sendBtn:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #5a78f0, stop: 1 #8a5bf0);
}

#loadBtn:disabled, #sendBtn:disabled {
    background: rgba(139, 91, 255, 0.30);
    color: rgba(255, 255, 255, 0.55);
}

/* 停止按钮：暖红 */
#stopBtn {
    border: none;
    background: rgba(255, 92, 92, 0.85);
    color: white;
    font-weight: 600;
}

#stopBtn:hover {
    background: rgba(255, 92, 92, 1);
}

#stopBtn:disabled {
    background: rgba(255, 92, 92, 0.25);
    color: rgba(255, 255, 255, 0.55);
}

/* —— 主题切换按钮（配置页·性能与界面） —— */
#themeLightBtn, #themeDarkBtn, #themePinkBtn, #langZhBtn, #langEnBtn {
    padding: 6px 16px;
}

#themeLightBtn:checked, #themeDarkBtn:checked, #themePinkBtn:checked, #langZhBtn:checked, #langEnBtn:checked {
    border: none;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #6f8cff, stop: 1 #a06bff);
    color: white;
    font-weight: 600;
}

#themeLightBtn:hover:!checked, #themeDarkBtn:hover:!checked, #themePinkBtn:hover:!checked, #langZhBtn:hover:!checked, #langEnBtn:hover:!checked {
    border: 1px solid #8fa8ff;
    color: #8fa8ff;
}

/* —— 状态栏 —— */
QStatusBar {
    background: transparent;
    color: #a6a6bc;
}

QStatusBar::item {
    border: none;
}

/* —— 分组框（全量配置分组） —— */
QGroupBox {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 8px;
    background: rgba(255, 255, 255, 0.04);
    font-weight: 600;
    color: #c8c8d8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #8fa8ff;
}

/* —— 标签页（配置页面） —— */
QTabWidget::pane {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #a6a6bc;
    padding: 8px 22px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.10);
    color: #8fa8ff;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.06);
}

/* —— 配置页滚动区（内容超高时滚动，底部按钮保持可见） —— */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* —— 复选框 —— */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.30);
    background: rgba(255, 255, 255, 0.08);
}

QCheckBox::indicator:hover {
    border: 1px solid #8fa8ff;
}

QCheckBox::indicator:checked {
    border: none;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #6f8cff, stop: 1 #a06bff);
    image: url(:/assets/icons/check-white.svg);
}

QCheckBox::indicator:disabled {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

/* —— 进度条（模型下载） —— */
QProgressBar {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    height: 16px;
    text-align: center;
    color: #a6a6bc;
}

QProgressBar::chunk {
    border-radius: 7px;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #6f8cff, stop: 1 #a06bff);
}

/* —— 滚动条 —— */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.20);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.38);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.20);
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* —— 模型管理表格 —— */
QTableWidget, QTableView {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 10px;
    gridline-color: rgba(255, 255, 255, 0.06);
    font-size: 13px;
    alternate-background-color: rgba(255, 255, 255, 0.03);
}

QTableWidget::item, QTableView::item {
    padding: 5px 8px;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(111, 140, 255, 0.30);
    color: #f0f0f8;
}

QHeaderView::section {
    background: #2b2c3d;
    color: #d8d8e6;
    padding: 7px 8px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    font-weight: 600;
}

/* —— 提示气泡 —— */
QToolTip {
    background: #101019;
    color: #f2f2f7;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 7px;
    padding: 5px 9px;
}

/* 模型列表悬停介绍（自绘不透明提示窗） */
#modelHoverTip {
    background: #101019;
    color: #f2f2f7;
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 9px 12px;
    font-size: 12px;
}

/* —— 消息框（非半透明窗口，用实底） —— */
QMessageBox {
    background: #232432;
}
